{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!!.jj",
      "!!**/node_modules",
      "!!evals/.lux-runs",
      "!!evals/.lux-cache",
      "!!evals/fixtures/integrations/orders",
      "!!evals/fixtures/integrations/tickets",
      "!!evals/fixtures/migrations/paragon-send-slack-message/input/legacy",
      "!!evals/fixtures/migrations/paragon-create-contact/input/legacy",
      "!!evals/fixtures/migrations/github-actions-discord/input/legacy",
      "!!evals/fixtures/migrations/github-actions-slack/input/legacy",
      "!!evals/fixtures/migrations/mulesoft-order-processing/input/source",
      "!!evals/fixtures/migrations/mulesoft-order-processing/expected",
      "!!evals/fixtures/migrations/cyclr-order-sync-incomplete/input/cycle.json",
      "!!evals/fixtures/migrations/workato-contact/input/legacy/upsert-contact.json",
      "!!evals/fixtures/migrations/bespoke-office-onboarding-reminders/input/legacy/offices.json",
      "!!evals/fixtures/migrations/logic-apps-*/input/legacy/*.json",
      "!!evals/fixtures/embedded/acme-portal"
    ]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "plugins": ["./biome/arrow-functions.grit"],
  "linter": {
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useArrowFunction": "error"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "node:fs": {
                "allowImportNames": ["existsSync"],
                "message": "Use node:fs/promises for filesystem operations."
              },
              "fs": {
                "allowImportNames": ["existsSync"],
                "message": "Use node:fs/promises for filesystem operations."
              }
            }
          }
        }
      }
    }
  }
}
